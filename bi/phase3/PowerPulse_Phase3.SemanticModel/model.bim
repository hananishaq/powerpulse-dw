            "dataType": "string",
            "sourceColumn": "demand_cohort",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "measures": [
          {
            "name": "Signed Mix Share",
            "expression": "DIVIDE(SUM(HighDemandMix[signed_group_mwh]), SUMX(SUMMARIZE(HighDemandMix, HighDemandMix[authority_key], HighDemandMix[month_start], HighDemandMix[demand_cohort]), CALCULATE(MAX(HighDemandMix[signed_total_mwh]))))",
            "formatString": "0.00%"
          }
        ],
        "partitions": [
          {
            "name": "HighDemandMix",
            "mode": "import",
