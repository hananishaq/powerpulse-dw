                "    Selected = Table.SelectColumns(Data, {\"authority_key\", \"month_start\", \"signed_generation_mwh\", \"numeric_observations\", \"observed_negative_hours\", \"supplied_blank_hours\", \"absent_header_hours\", \"source_group\", \"source_label\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"authority_key\", Int64.Type}, {\"month_start\", type datetime}, {\"signed_generation_mwh\", type number}, {\"numeric_observations\", Int64.Type}, {\"observed_negative_hours\", Int64.Type}, {\"supplied_blank_hours\", Int64.Type}, {\"absent_header_hours\", Int64.Type}, {\"source_group\", type text}, {\"source_label\", type text}})",
                "in",
                "    Typed"
