                "    Data = Source{[Schema=\"project_reporting\",Item=\"vw_dashboard_month\"]}[Data],",
                "    Selected = Table.SelectColumns(Data, {\"month_start\", \"calendar_year\", \"month_number\", \"year_month\", \"season\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"month_start\", type datetime}, {\"calendar_year\", Int64.Type}, {\"month_number\", Int64.Type}, {\"year_month\", type text}, {\"season\", type text}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
