        ]
      },
      {
        "name": "Renewables",
        "columns": [
          {
            "name": "authority_key",
            "dataType": "int64",
            "sourceColumn": "authority_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "month_start",
            "dataType": "dateTime",
            "sourceColumn": "month_start",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "matched_wind_mwh",
            "dataType": "double",
            "sourceColumn": "matched_wind_mwh",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "matched_solar_mwh",
            "dataType": "double",
            "sourceColumn": "matched_solar_mwh",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "matched_reported_mwh",
            "dataType": "double",
            "sourceColumn": "matched_reported_mwh",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "matched_hours",
            "dataType": "int64",
            "sourceColumn": "matched_hours",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "excluded_hours",
            "dataType": "int64",
            "sourceColumn": "excluded_hours",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "measures": [
          {
            "name": "Wind and Solar Share",
            "expression": "DIVIDE(SUM(Renewables[matched_wind_mwh]) + SUM(Renewables[matched_solar_mwh]), SUM(Renewables[matched_reported_mwh]))",
            "formatString": "0.00%"
          },
          {
            "name": "Matched Renewable Hours",
            "expression": "SUM(Renewables[matched_hours])",
            "formatString": "#,0"
          },
          {
            "name": "Excluded Renewable Hours",
            "expression": "SUM(Renewables[excluded_hours])",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "Renewables",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(PgServer, PgDatabase),",
                "    Data = Source{[Schema=\"project_reporting\",Item=\"vw_q08_wind_solar_share\"]}[Data],",
                "    Selected = Table.SelectColumns(Data, {\"authority_key\", \"month_start\", \"matched_wind_mwh\", \"matched_solar_mwh\", \"matched_reported_mwh\", \"matched_hours\", \"excluded_hours\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"authority_key\", Int64.Type}, {\"month_start\", type datetime}, {\"matched_wind_mwh\", type number}, {\"matched_solar_mwh\", type number}, {\"matched_reported_mwh\", type number}, {\"matched_hours\", Int64.Type}, {\"excluded_hours\", Int64.Type}})",
                "in",
