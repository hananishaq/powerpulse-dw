        "measures": [
          {
            "name": "Residual Failure Rate",
            "expression": "DIVIDE(SUM(Quality[residual_failure_hours]), SUM(Quality[comparable_hours]))",
            "formatString": "0.00%"
          },
          {
            "name": "Affected Core Hour Rate",
            "expression": "DIVIDE(SUM(Quality[affected_core_hours]), SUM(Quality[expected_hours]))",
            "formatString": "0.00%"
          }
        ],
